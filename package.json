{
  "name": "tzardom-ui",
  "version": "0.2.0",
  "private": true,
  "description": "React component library workspace",
  "license": "MIT",
  "packageManager": "pnpm@11.28.0",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "kill-ports": "node scripts/kill-ports.mjs",
    "build": "pnpm -r --if-present run build",
    "test:coverage": "pnpm -r --if-present run test:coverage",
    "test:e2e": "pnpm -r --if-present run test:e2e",
    "changeset": "changeset",
    "changeset:branch": "node scripts/changeset-branch.mjs",
    "version:packages": "GITHUB_TOKEN=$(gh auth token) changeset version",
    "app:link": "node scripts/link-app.mjs",
    "app:dev": "node scripts/link-app.mjs --watch",
    "app:unlink": "node scripts/link-app.mjs --unlink",
    "lint": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint --fix .",
    "license": "node scripts/license-year.mjs",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "10.6.0",
    "kill-port": "^2.0.1",
    "prettier": "^3.9.9",
    "rimraf": "^6.1.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
