{
  "name": "tzardom-ui",
  "version": "0.3.0",
  "private": true,
  "description": "React component library workspace",
  "license": "MIT",
  "packageManager": "pnpm@11.28.0",
  "scripts": {
    "dev": "node scripts/run-dev.mjs",
    "clean": "node scripts/clean.mjs",
    "build": "pnpm -r --if-present run build",
    "test:coverage": "pnpm -r --if-present run test:coverage",
    "test:e2e": "pnpm -r --if-present run test:e2e",
    "storybook": "pnpm --filter @tzardom-ui/storybook run storybook",
    "lint": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint --fix .",
    "license": "node scripts/license-year.mjs",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "10.6.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
