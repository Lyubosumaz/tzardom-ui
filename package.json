{
  "name": "tzardom-ui",
  "version": "0.1.1",
  "private": true,
  "description": "Multi-framework component library workspace",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "setup": "npm install --legacy-peer-deps",
    "build": "npm run build --workspaces --if-present",
    "clean": "rimraf packages/*/dist packages/*/loader packages/*/www packages/*/.stencil packages/*/src/generated packages/*/test-results packages/*/playwright-report packages/*/storybook-static node_modules packages/*/node_modules package-lock.json",
    "clean:cache": "rimraf packages/*/node_modules/.cache packages/*/node_modules/.vite packages/*/node_modules/.vite-temp",
    "kill-ports": "kill-port 3333 6006; pkill -f 'stencil build --dev' 2>/dev/null; pkill -f 'storybook dev' 2>/dev/null; true",
    "version:bump": "node scripts/bump-version.mjs",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspaces --if-present",
    "storybook": "npm run storybook --workspace=@tzardom-ui/react",
    "storybook:build": "npm run build-storybook --workspace=@tzardom-ui/react",
    "lint": "prettier --write . && eslint --fix .)"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^15.14.0",
    "kill-port": "^2.0.1",
    "prettier": "^3.9.8",
    "rimraf": "^6.1.3",
    "typescript-eslint": "^8.70.0"
  }
}
