{
  "name": "@tzardom-ui/core",
  "version": "0.1.6",
  "description": "Framework-agnostic components for tzardom-ui, built with Stencil",
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/tzardom-ui-core/tzardom-ui-core.esm.js",
  "files": [
    "dist/",
    "loader/"
  ],
  "dependencies": {
    "@tzardom-ui/types": "^0.0.6"
  },
  "scripts": {
    "build": "stencil build",
    "start": "stencil build --dev --watch --serve",
    "test": "vitest run --project spec",
    "test:coverage": "vitest run --project spec --coverage",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@stencil/core": "^4.23.0",
    "@stencil/playwright": "^0.5.1",
    "@stencil/react-output-target": "^1.6.2",
    "@stencil/sass": "^3.0.13",
    "@stencil/vitest": "^1.15.1",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.11"
  },
  "license": "MIT"
}
