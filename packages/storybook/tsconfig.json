{
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["./src/*", "../react/src/*"],
      "@tzardom-ui/react": ["../react/src/index.ts"]
    },
    "types": ["node"],
    "isolatedModules": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src", ".storybook/*.ts", "vite.config.mts"]
}
