{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "isolatedModules": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./*", "../react/src/*"],
      "@tzardom-ui/react": ["../react/src/index.ts"]
    }
  },
  "include": ["tests", "support", "playwright.config.ts"]
}
