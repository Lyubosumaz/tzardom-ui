{
  "name": "@tzardom-ui/react",
  "version": "0.3.1",
  "description": "My pet component library",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tailwind.css": "./tailwind.css",
    "./themes/*": "./themes/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "tailwind.css",
    "themes"
  ],
  "scripts": {
    "build": "rm -rf dist && rollup --config",
    "test:coverage": "vitest run --coverage"
  },
  "author": "Lyubosumaz",
  "license": "MIT",
  "dependencies": {
    "lucide-react": "^1.7.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.3.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@tzardom-ui/mocks": "workspace:*",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rollup": "^4.63.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
