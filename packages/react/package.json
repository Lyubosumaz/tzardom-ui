{
  "name": "@tzardom-ui/react",
  "version": "0.2.8",
  "description": "My pet component library",
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./icons": {
      "types": "./dist/esm/types/icons.d.ts",
      "import": "./dist/esm/icons.js",
      "require": "./dist/cjs/icons.js"
    },
    "./themes/*": "./themes/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "themes"
  ],
  "scripts": {
    "build": "rollup --config",
    "pretest:coverage": "pnpm --filter \"@tzardom-ui/core...\" run build",
    "test:coverage": "vitest run --coverage",
    "prestorybook": "pnpm --filter \"@tzardom-ui/core...\" run build",
    "storybook": "storybook dev -p 6006",
    "prebuild-storybook": "pnpm --filter \"@tzardom-ui/core...\" run build",
    "build-storybook": "storybook build"
  },
  "author": "Lyubosumaz",
  "license": "MIT",
  "dependencies": {
    "@stencil/react-output-target": "^1.6.2",
    "@tzardom-ui/core": "workspace:^",
    "@tzardom-ui/types": "workspace:^",
    "lucide-react": "^1.7.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-links": "^10.6.0",
    "@storybook/addon-mcp": "^10.6.0",
    "@storybook/react-vite": "^10.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rollup": "^4.63.5",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
