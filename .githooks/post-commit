#!/usr/bin/env bash
set -e

# Runs again for the amend below; stop there.
[ -n "$CHANGESET_AMEND" ] && exit 0

node scripts/changeset-branch.mjs

if [ -n "$(git status --porcelain -- .changeset)" ]; then
  git add -- .changeset
  CHANGESET_AMEND=1 git commit --amend --no-edit --no-verify --quiet
fi
