#!/usr/bin/env bash
set -e
IFS=$'\n'

files=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$files" ] && exit 0

# Half-staged files would sneak unstaged changes into the commit.
half=$(git diff --name-only -- $files)
if [ -n "$half" ]; then
  echo "Stage these files fully first (git add):"
  echo "$half"
  exit 1
fi

pick() { echo "$files" | grep -E "$1" || true; }
code=$(pick '\.(js|mjs|cjs|ts|tsx|mts)$')
docs=$(pick '\.(json|md|ya?ml|css|html)$')

[ -n "$code" ] && pnpm exec eslint --fix --max-warnings=0 --no-warn-ignored $code
[ -n "$code$docs" ] && pnpm exec prettier --write --ignore-unknown $code $docs

git add -- $files
pnpm run test:coverage
